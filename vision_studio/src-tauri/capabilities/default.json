{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-web-search-duckduckgo",
    "allow-set-workspace",
    "allow-list-dir",
    "allow-read-file-content",
    "allow-write-file-content",
    "allow-execute-powershell-command"
  ]
}
